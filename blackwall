#!/usr/bin/env bash
# BlackWall — AI-driven malware analysis lab.
#
# The host only ever holds samples as password-protected zips. Each case gets
# its own hardened container (no network, no capabilities, read-only rootfs)
# where the sample is unpacked into a private volume; Claude Code runs on the
# host and reaches the tools in that container over MCP via `docker exec`.
set -euo pipefail

BW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
[ -f "$BW_ROOT/.env" ] && { set -a; . "$BW_ROOT/.env"; set +a; }

IMAGE="${BLACKWALL_IMAGE:-blackwall:latest}"
CASES="${BLACKWALL_CASES:-$HOME/BlackWall-cases}"
MEM="${BLACKWALL_MEM:-8g}"
CPUS="${BLACKWALL_CPUS:-4}"
ZIP_PW="infected"

c_red=$'\e[31m'; c_grn=$'\e[32m'; c_yel=$'\e[33m'; c_dim=$'\e[2m'; c_off=$'\e[0m'
die()  { echo "${c_red}error:${c_off} $*" >&2; exit 1; }
info() { echo "${c_grn}==>${c_off} $*" >&2; }
warn() { echo "${c_yel}warn:${c_off} $*" >&2; }

usage() {
  cat <<EOF
BlackWall — AI-driven malware analysis lab

usage: blackwall <command> [args]

  setup                    build the analysis image and check the host
  doctor                   check host prerequisites and image health
  pull <sha256>            fetch a sample from MalwareBazaar (needs ABUSECH_API_KEY)
  add <file>               add a local sample (zipped with password '$ZIP_PW')
  list                     list cases
  analyze <id> [--gui] [--auto] [-- <claude args>]
                           start the sandbox and launch Claude Code in the case
                             --gui   also open Ghidra's GUI (X11) driven by the same MCP session
                             --auto  start with an autonomous triage → deep-dive prompt
  start <id> [--gui]       start the sandbox only
  stop <id>                stop the sandbox (analysis state is kept)
  shell <id>               open a shell inside the sandbox
  rm <id> [--purge]        delete sandbox + its volume (--purge also deletes the case dir)

<id> is any unique prefix of the sample's sha256.
Cases live in: $CASES
EOF
}

# ------------------------------------------------------------------ helpers

need_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE not built; run: blackwall setup"
}

resolve() {
  local prefix="${1:-}" m
  [ -n "$prefix" ] || die "missing case id"
  prefix="${prefix,,}"
  mapfile -t m < <(find "$CASES" -mindepth 1 -maxdepth 1 -type d -name "${prefix}*" -printf '%f\n' 2>/dev/null)
  [ "${#m[@]}" -eq 1 ] || { [ "${#m[@]}" -eq 0 ] && die "no case matches '$prefix'"; die "'$prefix' is ambiguous: ${m[*]}"; }
  echo "${m[0]}"
}

cname() { echo "bw-${1:0:12}"; }
vname() { echo "bw-work-${1:0:12}"; }

new_case_dir() {
  local sha=$1 dir="$CASES/$1"
  [ -e "$dir/sample.zip" ] && die "case already exists: $dir"
  mkdir -p "$dir"/{notes,detections,exports}
  echo "$dir"
}

write_case_json() {  # sha source original_name
  jq -n --arg sha "$1" --arg src "$2" --arg name "$3" --arg t "$(date -u +%FT%TZ)" \
    '{sha256:$sha, source:$src, original_name:$name, added:$t}' > "$CASES/$1/case.json"
}

container_running() { [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]; }
container_gui()     { docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$1" 2>/dev/null | grep -q '^BW_GUI=1$'; }

start_sandbox() {  # sha gui(0|1)
  local sha=$1 gui=$2 c v dir
  c=$(cname "$sha"); v=$(vname "$sha"); dir="$CASES/$sha"
  need_image

  if docker inspect "$c" >/dev/null 2>&1; then
    if [ "$gui" = 1 ] && ! container_gui "$c"; then
      info "recreating sandbox with GUI support (analysis state is kept in volume $v)"
      docker rm -f "$c" >/dev/null
    elif ! container_running "$c"; then
      docker start "$c" >/dev/null
    fi
  fi

  if ! docker inspect "$c" >/dev/null 2>&1; then
    local gui_args=()
    if [ "$gui" = 1 ]; then
      [ -n "${DISPLAY:-}" ] || die "--gui needs an X11 DISPLAY"
      xhost "+SI:localuser:$(id -un)" >/dev/null 2>&1 || warn "xhost failed; the Ghidra window may not open"
      gui_args=(-e BW_GUI=1 -e DISPLAY="$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix:ro)
    fi
    info "starting sandbox $c (network: none)"
    docker run -d --init --name "$c" --hostname sandbox \
      --network none \
      --cap-drop ALL --security-opt no-new-privileges \
      --read-only --tmpfs /tmp:rw,exec,nosuid,nodev,size=4g \
      --pids-limit 2048 --memory "$MEM" --cpus "$CPUS" \
      -v "$v":/work \
      -v "$dir/sample.zip":/case/sample.zip:ro \
      -v "$dir/detections":/case/detections \
      -v "$dir/exports":/case/exports \
      "${gui_args[@]}" \
      --label blackwall.case="$sha" \
      "$IMAGE" >/dev/null
  fi
  docker exec "$c" bw-init "$sha" >/dev/null || die "sample extraction failed (see: docker exec $c bw-init $sha)"
}

write_mcp_config() {  # sha gui
  local sha=$1 gui=$2 c ghidra_args
  c=$(cname "$sha")
  ghidra_args='["exec","-i","'"$c"'","bw-ghidra-mcp"]'
  [ "$gui" = 1 ] && ghidra_args='["exec","-i","'"$c"'","bw-ghidra-mcp","--gui"]'
  jq -n --argjson ga "$ghidra_args" --arg c "$c" --arg img "$IMAGE" '{
    mcpServers: {
      ghidra:  {command: "docker", args: $ga},
      lab:     {command: "docker", args: ["exec","-i",$c,"bw-lab-mcp"]},
      radare2: {command: "docker", args: ["exec","-i",$c,"bw-r2mcp"]},
      intel:   {command: "docker", args: ["run","--rm","-i","--cap-drop","ALL",
                  "--security-opt","no-new-privileges","--read-only","--tmpfs","/tmp",
                  "-e","HOME=/tmp","-e","ABUSECH_API_KEY","-e","VT_API_KEY",
                  $img,"bw-intel-mcp"]}
    }}' > "$CASES/$sha/.mcp.json"
}

sync_playbook() {  # sha — refresh the analyst playbook (CLAUDE.md, skills, settings)
  local dir="$CASES/$1"
  cp "$BW_ROOT/analyst/CLAUDE.md" "$dir/CLAUDE.md"
  mkdir -p "$dir/.claude"
  rm -rf "$dir/.claude/skills"
  cp -r "$BW_ROOT/analyst/.claude/skills" "$dir/.claude/skills"
  cp "$BW_ROOT/analyst/.claude/settings.json" "$dir/.claude/settings.json"
}

# ------------------------------------------------------------------ commands

cmd_doctor() {
  local ok=1
  check() { if eval "$2" >/dev/null 2>&1; then echo "  ${c_grn}✓${c_off} $1"; else echo "  ${c_red}✗${c_off} $1 ${c_dim}($3)${c_off}"; ok=0; fi; }
  optional() { if eval "$2" >/dev/null 2>&1; then echo "  ${c_grn}✓${c_off} $1"; else echo "  ${c_yel}-${c_off} $1 ${c_dim}($3)${c_off}"; fi; }
  echo "host:"
  check "docker reachable"            "docker info"                        "install docker / add yourself to the docker group"
  check "jq"                          "command -v jq"                      "apt install jq"
  check "claude (Claude Code)"        "command -v claude"                  "https://claude.com/claude-code"
  check "image $IMAGE"                "docker image inspect $IMAGE"        "blackwall setup"
  optional "KVM (for phase-2 dynamic)"   "test -w /dev/kvm"                   "optional for now"
  optional "abuse.ch key (pull/intel)"   "test -n '${ABUSECH_API_KEY:-}'"     "optional; set ABUSECH_API_KEY in $BW_ROOT/.env"
  optional "VirusTotal key (intel)"      "test -n '${VT_API_KEY:-}'"          "optional; set VT_API_KEY in $BW_ROOT/.env"
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "image:"
    check "sandbox has no network"    "! docker run --rm --network none $IMAGE curl -s -m 3 https://1.1.1.1" "network leak!"
    check "Ghidra"                    "docker run --rm $IMAGE test -x /opt/ghidra/support/analyzeHeadless" "rebuild"
    check "pyghidra-mcp"              "docker run --rm $IMAGE pyghidra-mcp --version" "rebuild"
    check "radare2 + r2mcp"           "docker run --rm $IMAGE sh -c 'r2 -v && command -v r2mcp'" "rebuild"
    check "capa / floss / diec / upx" "docker run --rm $IMAGE sh -c 'capa --version && floss --version && command -v diec upx'" "rebuild"
    check "lab MCP server imports"    "docker run --rm -e HOME=/tmp $IMAGE python -c 'import blackwall_lab.server, blackwall_lab.intel'" "rebuild"
  fi
  [ "$ok" = 1 ] && info "all good" || warn "some checks failed"
}

cmd_setup() {
  command -v docker >/dev/null || die "docker is required"
  [ -f "$BW_ROOT/.env" ] || { cp "$BW_ROOT/.env.example" "$BW_ROOT/.env"; info "created .env — add your API keys there"; }
  info "building $IMAGE (first build downloads Ghidra, JDK and tooling; several minutes)"
  docker build --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
    -t "$IMAGE" -f "$BW_ROOT/docker/Dockerfile" "$BW_ROOT"
  mkdir -p "$CASES"
  cmd_doctor
}

cmd_pull() {
  local sha="${1:-}"; sha="${sha,,}"
  [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "pull needs a full sha256"
  [ -n "${ABUSECH_API_KEY:-}" ] || die "set ABUSECH_API_KEY in $BW_ROOT/.env (free: https://auth.abuse.ch/)"
  local dir; dir=$(new_case_dir "$sha")
  info "fetching $sha from MalwareBazaar"
  curl -fsS -X POST -H "Auth-Key: $ABUSECH_API_KEY" \
    -d "query=get_file&sha256_hash=$sha" -o "$dir/sample.zip" https://mb-api.abuse.ch/api/v1/ \
    || { rm -rf "$dir"; die "download failed"; }
  if ! file -b "$dir/sample.zip" | grep -q '^Zip archive'; then
    local msg; msg=$(head -c 300 "$dir/sample.zip"); rm -rf "$dir"; die "MalwareBazaar: $msg"
  fi
  curl -fsS -X POST -H "Auth-Key: $ABUSECH_API_KEY" -d "query=get_info&hash=$sha" \
    https://mb-api.abuse.ch/api/v1/ | jq '.data[0] // .' > "$dir/notes/malwarebazaar.json" || true
  local name; name=$(jq -r '.file_name // ""' "$dir/notes/malwarebazaar.json" 2>/dev/null || true)
  write_case_json "$sha" malwarebazaar "$name"
  info "case ready: $dir  →  blackwall analyze ${sha:0:12}"
}

cmd_add() {
  local src="${1:-}"
  [ -f "$src" ] || die "no such file: $src"
  src=$(readlink -f "$src")
  local sha name dir
  sha=$(sha256sum "$src" | cut -d' ' -f1)
  name=$(basename "$src")
  need_image
  dir=$(new_case_dir "$sha")
  # Zip inside a throwaway sandbox so nothing on the host has to parse the sample.
  docker run --rm --network none --cap-drop ALL --read-only --tmpfs /tmp \
    -v "$src":/in/sample:ro -v "$dir":/out "$IMAGE" \
    7z a -tzip -p"$ZIP_PW" -y /out/sample.zip /in/sample >/dev/null
  write_case_json "$sha" local "$name"
  info "case ready: $dir  →  blackwall analyze ${sha:0:12}"
  warn "the original file is still at $src — delete it if it shouldn't stay on the host"
}

cmd_list() {
  mkdir -p "$CASES"
  printf '%-14s %-10s %-28s %-8s %s\n' ID SOURCE NAME SANDBOX REPORT
  for d in "$CASES"/*/; do
    [ -f "$d/case.json" ] || continue
    local sha src name state rep
    sha=$(jq -r .sha256 "$d/case.json"); src=$(jq -r .source "$d/case.json"); name=$(jq -r '.original_name // ""' "$d/case.json")
    if container_running "$(cname "$sha")"; then state=up; elif docker inspect "$(cname "$sha")" >/dev/null 2>&1; then state=stopped; else state=-; fi
    [ -f "$d/report.md" ] && rep=yes || rep=-
    printf '%-14s %-10s %-28.28s %-8s %s\n' "${sha:0:12}" "$src" "$name" "$state" "$rep"
  done
}

cmd_start() {
  local sha gui=0; sha=$(resolve "${1:-}"); shift || true
  [ "${1:-}" = "--gui" ] && gui=1
  start_sandbox "$sha" "$gui"
  write_mcp_config "$sha" "$gui"
  info "sandbox $(cname "$sha") is up"
}

cmd_analyze() {
  local sha gui=0 auto=0 extra=()
  sha=$(resolve "${1:-}"); shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --gui) gui=1 ;; --auto) auto=1 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown option: $1" ;;
    esac; shift
  done
  command -v claude >/dev/null || die "Claude Code (claude) not found"
  start_sandbox "$sha" "$gui"
  write_mcp_config "$sha" "$gui"
  sync_playbook "$sha"
  info "launching Claude Code in $CASES/$sha"
  [ "$gui" = 1 ] && info "Ghidra GUI opens when the ghidra MCP server starts (first launch can take ~1 min)"
  cd "$CASES/$sha"
  # Strict MCP config: the session sees only the lab's servers, never your
  # other MCP servers or claude.ai connectors (mail, drive...), so a prompt
  # injection hidden in a sample has nothing outside the sandbox to reach.
  # (--mcp-config is variadic, so any prompt has to come before it.)
  local mcp=(--strict-mcp-config --mcp-config "$CASES/$sha/.mcp.json")
  if [ "$auto" = 1 ]; then
    exec claude "Analyze this case end to end: run the triage skill, then the deep-analysis skill, extract any config, write detections, and finish with the report skill. Work autonomously; only stop to ask me if you are blocked." "${extra[@]}" "${mcp[@]}"
  fi
  exec claude "${extra[@]}" "${mcp[@]}"
}

cmd_stop()  { local sha; sha=$(resolve "${1:-}"); docker stop "$(cname "$sha")" >/dev/null && info "stopped"; }
cmd_shell() { local sha; sha=$(resolve "${1:-}"); container_running "$(cname "$sha")" || start_sandbox "$sha" 0; exec docker exec -it -w /work "$(cname "$sha")" bash; }

cmd_rm() {
  local sha; sha=$(resolve "${1:-}")
  docker rm -f "$(cname "$sha")" >/dev/null 2>&1 || true
  docker volume rm "$(vname "$sha")" >/dev/null 2>&1 || true
  info "removed sandbox and analysis volume for ${sha:0:12}"
  if [ "${2:-}" = "--purge" ]; then
    read -r -p "delete case dir $CASES/$sha (sample zip, notes, report)? [y/N] " a
    [ "$a" = y ] && rm -rf "${CASES:?}/$sha" && info "case dir deleted"
  fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  setup) cmd_setup ;; doctor) cmd_doctor ;;
  pull) cmd_pull "$@" ;; add) cmd_add "$@" ;; list|ls) cmd_list ;;
  analyze|a) cmd_analyze "$@" ;; start) cmd_start "$@" ;; stop) cmd_stop "$@" ;;
  shell|sh) cmd_shell "$@" ;; rm) cmd_rm "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
