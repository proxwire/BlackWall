#!/opt/venv/bin/python3
"""Run an stdio MCP server and make sure it dies with its client.

`docker exec -i` delivers EOF on stdin when the client goes away, but servers
with non-daemon threads (the Ghidra JVM) keep running and keep the project
locked. This proxies stdin to the child; on EOF it closes the child's stdin,
then escalates SIGINT (pyghidra-mcp: save and close) -> SIGTERM -> SIGKILL.

usage: bw-stdio-guard <cmd> [args...]
"""

import os
import signal
import subprocess
import sys
import threading


def duration(name, default):
    try:
        value = float(os.environ.get(name, default))
    except ValueError:
        return default
    return min(max(value, 0.01), 300)


child = subprocess.Popen(
    sys.argv[1:],
    stdin=subprocess.PIPE,
    stdout=sys.stdout,
    stderr=sys.stderr,
    start_new_session=True,
)


def signal_group(signum):
    if child.poll() is None:
        try:
            os.killpg(child.pid, signum)
        except ProcessLookupError:
            pass


def pump():
    src = sys.stdin.buffer
    try:
        while True:
            chunk = src.read1(65536)
            if not chunk:
                break
            child.stdin.write(chunk)
            child.stdin.flush()
    except (BrokenPipeError, ValueError):
        pass
    finally:
        try:
            child.stdin.close()
        except Exception:
            pass
    waits = (
        (None, duration("BW_STDIO_EOF_GRACE", 5)),
        (signal.SIGINT, duration("BW_STDIO_INT_GRACE", 30)),
        (signal.SIGTERM, duration("BW_STDIO_TERM_GRACE", 10)),
        (signal.SIGKILL, duration("BW_STDIO_KILL_GRACE", 5)),
    )
    for sig, wait in waits:
        if sig is not None:
            signal_group(sig)
        try:
            child.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def forward(signum, _frame):
    signal_group(signum)


for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(s, forward)

t = threading.Thread(target=pump, daemon=True)
t.start()
rc = child.wait()
os._exit(rc if rc >= 0 else 128 - rc)
