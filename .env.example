# abuse.ch Auth-Key (MalwareBazaar pulls, ThreatFox/URLhaus lookups). Free: https://auth.abuse.ch/
ABUSECH_API_KEY=
# VirusTotal API key (hash lookups only; BlackWall never uploads samples)
VT_API_KEY=
# Where case folders live (kept outside the repo so analyst sessions don't inherit its CLAUDE.md)
# BLACKWALL_CASES=$HOME/BlackWall-cases
# Sandbox resources
# BLACKWALL_MEM=8g
# BLACKWALL_CPUS=4
